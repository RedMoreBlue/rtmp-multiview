# Copy to .env and fill in. Never commit .env.

# Web login. Plain text works; a hash is better:
#   docker run --rm -it ghcr.io/redmoreblue/rtmp-multiview --hash-password
# (put the hash in single quotes here, it contains $ signs)
MV_PASSWORD='change-me-to-a-long-passphrase'

# Optional second password that is required to open the settings (stream keys).
# Leave empty to let everyone who can log in change settings.
MV_ADMIN_PASSWORD=''

# For the https profile: public DNS name pointing at this host.
MV_DOMAIN=multiview.example.com

# Where port 8080 (plain HTTP) listens on the host. 127.0.0.1 = only via Caddy/HTTPS.
MV_HTTP_BIND=0.0.0.0
